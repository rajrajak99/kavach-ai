{
  "name": "kavach-ai",
  "displayName": "Kavach AI: AST Security Gate & 1-Click Self-Healing",
  "description": "Sub-16ms AST security gate with 0% false positives and 1-click compile-ready self-healing patches for Python, JavaScript, TypeScript, and C++.",
  "version": "1.0.0",
  "publisher": "rajrajak99",
  "repository": {
    "type": "git",
    "url": "https://github.com/rajrajak99/kavach-ai.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Security"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:python",
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:cpp",
    "onLanguage:c"
  ],
  "contributes": {
    "commands": [
      {
        "command": "kavach.scanFile",
        "title": "Kavach AI: Scan Current File",
        "category": "Kavach AI"
      },
      {
        "command": "kavach.healFile",
        "title": "Kavach AI: Self-Heal File (Apply Patches & Run Tests)",
        "category": "Kavach AI"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "kavach.scanFile",
          "group": "kavach@1"
        },
        {
          "command": "kavach.healFile",
          "group": "kavach@2"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "Kavach AI Configuration",
      "properties": {
        "kavach.scanOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically inspect files for security flaws and crashes upon save."
        },
        "kavach.testCommand": {
          "type": "string",
          "default": "pytest",
          "description": "Command run during self-healing test verification."
        }
      }
    }
  }
}
